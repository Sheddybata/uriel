# RouterOS 7 REST. Use the router address the server can reach.
MIKROTIK_HOST=https://192.168.88.1
MIKROTIK_USER=uriel
MIKROTIK_PASSWORD=
# Interface facing Starlink. Download is rx on that port.
MIKROTIK_WAN_INTERFACE=ether1
MIKROTIK_CAPACITY=100
# RouterOS ships with a self-signed certificate.
MIKROTIK_TLS_INSECURE=true
